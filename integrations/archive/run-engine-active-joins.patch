+"""Active-path joins preserve legacy defaults and checkpoint deferred work."""
+
+import pytest
+from runengine.programs.graph.models.enums import JoinPolicy
+from runengine.programs.graph.models.graph import ConditionalEdgeDef, GraphDefinition, NodeDef
+from runengine.programs.graph.models.state import GraphState
+from runengine.programs.graph.traversal.bsp import BSPTraversal
+
+
+def topology(*, active=True, unequal=False):
+    names = ("root", "left", "right", "tail", "join")
+    return GraphDefinition(
+        nodes={name: NodeDef(uid=name) for name in names},
+        edges={"left": ["join"], "right": ["tail" if unequal else "join"], "tail": ["join"]},
+        conditional_edges={"root": ConditionalEdgeDef(condition_id="route", branches={"left": "left", "right": "right"})},
+        entry="root", exit_node="join", join_policy=JoinPolicy.ACTIVE if active else JoinPolicy.ALL,
+    )
+
+
+async def both(*args):
+    return ["left", "right"]
+
+
+async def left(*args):
+    return "left"
+
+
+@pytest.mark.parametrize("active", [True, False])
+async def test_exclusive_branch_rejoin_is_opt_in(active):
+    strategy = BSPTraversal(topology(active=active))
+    state = GraphState()
+    assert await strategy.resolve_next({"root"}, {"root"}, state, left) == {"left"}
+    ready = await strategy.resolve_next({"left"}, {"root", "left"}, state, left)
+    assert ready == ({"join"} if active else set())
+
+
+async def test_unequal_active_paths_wait_and_restore_the_deferred_join():
+    graph = topology(unequal=True)
+    strategy = BSPTraversal(graph)
+    state = GraphState()
+    assert await strategy.resolve_next({"root"}, {"root"}, state, both) == {"left", "right"}
+    done = {"root", "left", "right"}
+    ready = await strategy.resolve_next({"left", "right"}, done, state, both)
+    assert ready == {"tail"}
+    restored = BSPTraversal(graph)
+    assert restored.restore_position(strategy.export_position(state, done, ready)) == ready
+    assert await restored.resolve_next(ready, done | ready, state, both) == {"join"}
+
+
+async def test_new_loop_round_waits_for_fresh_active_paths_despite_previous_completions():
+    graph = topology(unequal=True).model_copy(update={
+        "conditional_edges": {
+            **topology().conditional_edges,
+            "join": ConditionalEdgeDef(condition_id="again", branches={"repeat": "root"}),
+        },
+    })
+    strategy = BSPTraversal(graph)
+    state = GraphState()
+    done = set()
+    for _ in range(2):
+        for current, expected in (({"root"}, {"left", "right"}), ({"left", "right"}, {"tail"}), ({"tail"}, {"join"})):
+            done |= current
+            assert await strategy.resolve_next(current, done, state, both) == expected
+        async def repeat(*args):
+            return "repeat"
+        done.add("join")
+        assert await strategy.resolve_next({"join"}, done, state, repeat) == {"root"}
+
+
+def test_default_graph_and_empty_checkpoint_keep_legacy_serialization_shape():
+    graph = topology(active=False)
+    assert "join_policy" not in graph.model_dump(mode="json")
+    assert BSPTraversal(graph).export_position(GraphState(), set(), {"root"}) == {"active_nodes": ["root"]}
+    active = topology()
+    assert active.model_dump(mode="json")["join_policy"] == "active"
+    assert GraphDefinition.model_validate(active.model_dump(mode="json")) == active
