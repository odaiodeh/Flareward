 class OpenShellPolicy(BaseModel):
     """Portable supported policy fields; SDK conversion belongs to the adapter."""
 
     model_config = ConfigDict(extra="forbid", revalidate_instances="always")
     version: int = Field(default=1, strict=True, ge=0, le=2**32 - 1)
     network_policies: dict[str, OpenShellNetworkRule] = Field(default_factory=dict)
+    filesystem_policy: OpenShellFilesystemPolicy | None = None
+    landlock: OpenShellLandlockPolicy | None = None
+    process: OpenShellProcessPolicy | None = None
+
+    @model_serializer(mode="wrap")
+    def omit_unconfigured_sections(self, handler: SerializerFunctionWrapHandler) -> dict[str, Any]:
+        data: dict[str, Any] = handler(self)
+        for name in ("filesystem_policy", "landlock", "process"):
+            if getattr(self, name) is None:
+                data.pop(name, None)
+        return data
 
 
