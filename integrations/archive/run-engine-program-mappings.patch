+    Field,
+    SerializerFunctionWrapHandler,
+    model_serializer,
+    model_validator,
+)
 
 from runengine.coordination.models import RunRequest
 from runengine.coordination.targets import EnvironmentName
 from runengine.core.refs import FunctionRef
+from runengine.programs.graph.models.execution import GraphCallArguments
 
 
 class ProgramNode(BaseModel):
@@ -14,4 +24,25 @@ class ProgramNode(BaseModel):
     request: RunRequest
     input_mapping: FunctionRef | None = None
     output_mapping: FunctionRef | None = None
+    input_arguments: GraphCallArguments = Field(default_factory=GraphCallArguments)
+    output_arguments: GraphCallArguments = Field(default_factory=GraphCallArguments)
     environment_imports: dict[EnvironmentName, EnvironmentName] = Field(default_factory=dict)
+
+    @model_validator(mode="after")
+    def validate_mapping_arguments(self) -> Self:
+        for mapping, arguments in (
+            (self.input_mapping, self.input_arguments),
+            (self.output_mapping, self.output_arguments),
+        ):
+            if mapping is None and (arguments.args or arguments.kwargs):
+                raise ValueError("Mapping arguments require a mapping function")
+        return self
+
+    @model_serializer(mode="wrap")
+    def serialize(self, handler: SerializerFunctionWrapHandler) -> dict[str, Any]:
+        payload: dict[str, Any] = handler(self)
+        for name in ("input_arguments", "output_arguments"):
+            arguments = getattr(self, name)
+            if not arguments.args and not arguments.kwargs:
+                payload.pop(name, None)
+        return payload
