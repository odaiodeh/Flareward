diff --git a/src/runengine/adapters/invocation/openshell/connection.py b/src/runengine/adapters/invocation/openshell/connection.py
new file mode 100644
--- /dev/null
+++ b/src/runengine/adapters/invocation/openshell/connection.py
@@ -0,0 +1,24 @@
+"""Translate portable certificate paths only at the OpenShell SDK boundary."""
+
+from collections.abc import Callable
+from pathlib import Path
+
+from openshell import SandboxClient, TlsConfig
+
+from runengine.invocation.config import OpenShellRunnerConfig
+
+
+def create_client(
+    config: OpenShellRunnerConfig, factory: Callable[..., SandboxClient]
+) -> SandboxClient:
+    if config.tls is None:
+        return factory(config.endpoint)
+    tls = config.tls
+    return factory(
+        config.endpoint,
+        tls=TlsConfig(
+            ca_path=Path(tls.ca_path) if tls.ca_path else None,
+            cert_path=Path(tls.cert_path) if tls.cert_path else None,
+            key_path=Path(tls.key_path) if tls.key_path else None,
+        ),
+    )
diff --git a/tests/unit/adapters/test_openshell_tls.py b/tests/unit/adapters/test_openshell_tls.py
new file mode 100644
--- /dev/null
+++ b/tests/unit/adapters/test_openshell_tls.py
@@ -0,0 +1,65 @@
+"""TLS stays an SDK adapter concern and preserves unconfigured wire compatibility."""
+
+from pathlib import Path
+from unittest.mock import Mock
+
+import pytest
+from pydantic import ValidationError
+
+pytest.importorskip("openshell")
+from openshell import TlsConfig
+
+from runengine.adapters.invocation.openshell import environment, factory
+from runengine.invocation.config import OpenShellRunnerConfig, OpenShellTLSConfig
+
+
+def test_tls_paths_round_trip_without_changing_default_payloads():
+    plain = OpenShellRunnerConfig(endpoint="gateway", image="test:image")
+    assert "tls" not in plain.model_dump(mode="json")
+    secured = OpenShellRunnerConfig(
+        endpoint="gateway",
+        image="test:image",
+        tls=OpenShellTLSConfig(ca_path="ca.crt", cert_path="client.crt", key_path="client.key"),
+    )
+    assert OpenShellRunnerConfig.model_validate_json(secured.model_dump_json()) == secured
+    secured.tls.cert_path = None
+    with pytest.raises(ValidationError):
+        OpenShellRunnerConfig.model_validate(secured)
+
+
+@pytest.mark.parametrize("driver", [False, True])
+def test_managed_and_invocation_clients_receive_sdk_tls_paths(monkeypatch, driver):
+    module = environment if driver else factory
+    client = Mock()
+    constructor = Mock(return_value=client)
+    monkeypatch.setattr(module, "SandboxClient", constructor)
+    config = OpenShellRunnerConfig(
+        endpoint="gateway",
+        image="test:image",
+        tls={"ca_path": "ca.crt", "cert_path": "client.crt", "key_path": "client.key"},
+    )
+    owner = module.OpenShellEnvironmentDriver(config) if driver else factory.Factory.create(config)
+    args, kwargs = constructor.call_args
+    assert args == ("gateway",)
+    assert isinstance(kwargs["tls"], TlsConfig)
+    assert kwargs["tls"].ca_path == Path("ca.crt")
+    assert kwargs["tls"].cert_path == Path("client.crt")
+    assert kwargs["tls"].key_path == Path("client.key")
+    owner.close() if driver else owner.clean()
+    client.close.assert_called_once()
+
+
+@pytest.mark.parametrize("identity", [{"cert_path": "client.crt"}, {"key_path": "client.key"}])
+def test_partial_client_identity_is_rejected_before_allocating_a_client(monkeypatch, identity):
+    constructor = Mock()
+    monkeypatch.setattr(factory, "SandboxClient", constructor)
+    with pytest.raises(ValidationError):
+        factory.Factory.create_from_dict(
+            {
+                "runner_type": "openshell",
+                "endpoint": "gateway",
+                "image": "test:image",
+                "tls": identity,
+            }
+        )
+    constructor.assert_not_called()
