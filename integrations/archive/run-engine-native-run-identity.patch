@@ -0,0 +1,169 @@
+"""Native ingress may reuse workflow IDs; pins and child identities retain the generation."""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+import pytest
+from temporalio import workflow
+from temporalio.api.common.v1 import WorkflowType
+from temporalio.api.enums.v1 import EventType
+from temporalio.api.history.v1 import (
+    ChildWorkflowExecutionStartedEventAttributes,
+    HistoryEvent,
+    StartChildWorkflowExecutionInitiatedEventAttributes,
+    WorkflowExecutionStartedEventAttributes,
+)
+from temporalio.client import WorkflowExecutionStatus
+from temporalio.converter import DataConverter
+
+from runengine.adapters.coordination.config import TemporalHostConfig
+from runengine.adapters.coordination.temporal.host import TemporalRunHandle, TemporalRunHost
+from runengine.adapters.coordination.temporal.models import RunParameters, TemporalRunIdentity
+from runengine.adapters.coordination.temporal.protocol import WORKFLOW_NAME
+from runengine.adapters.coordination.temporal.workflow import TemporalRunOperations
+from runengine.coordination.children import child_run_id
+from runengine.coordination.errors import RunContractError
+from runengine.coordination.models import RunRequest
+from runengine_test_fixtures import coordination
+
+
+def test_native_ingress_generations_do_not_share_run_or_child_identity(monkeypatch):
+    info = SimpleNamespace(namespace="tests", workflow_id="same-calendar-second", run_id="first")
+    monkeypatch.setattr(workflow, "info", lambda: info)
+    monkeypatch.setattr(workflow, "patched", lambda _: True)
+    params = RunParameters(request=RunRequest.create(coordination.echo))
+    first = TemporalRunOperations(None, params).run_id
+    info.run_id = "second"
+    second = TemporalRunOperations(None, params).run_id
+    assert first != second
+    assert child_run_id(first, "child") != child_run_id(second, "child")
+    assert TemporalRunIdentity.decode(first).workflow_id == info.workflow_id
+    assert TemporalRunIdentity.decode(first).run_id == "first"
+    assert TemporalRunIdentity.decode(second).run_id == "second"
+
+
+def test_ordinary_ids_and_old_native_histories_keep_their_identity(monkeypatch):
+    monkeypatch.setattr(workflow, "info", lambda: SimpleNamespace(workflow_id="original"))
+    monkeypatch.setattr(workflow, "patched", lambda _: False)
+    for run_id in ("", "original"):
+        params = RunParameters(request=RunRequest.create(coordination.echo, run_id=run_id))
+        assert TemporalRunOperations(None, params).run_id == "original"
+
+
+async def test_explicit_pins_address_only_the_original_generation_and_namespace():
+    native = Mock()
+    client = SimpleNamespace(namespace="tests", get_workflow_handle=native)
+    host = TemporalRunHost(TemporalHostConfig(namespace="tests"), client=client)
+    identity = TemporalRunIdentity(namespace="tests", workflow_id="workflow", run_id="first")
+    handle = await host.get_pinned_handle(identity)
+    assert handle.run_id == identity.encode()
+    native.assert_called_once_with("workflow", run_id="first", first_execution_run_id="first")
+    native.reset_mock()
+    with pytest.raises(ValueError, match="namespace"):
+        await host.get_pinned_handle(identity.model_copy(update={"namespace": "other"}))
+    native.assert_not_called()
+    # Ordinary run IDs, including strings resembling locators, stay uninterpreted.
+    await host.get_handle(identity.encode())
+    native.assert_called_once_with(identity.encode())
+
+
+@pytest.mark.parametrize("value", [None, ""])
+async def test_unchecked_empty_generation_is_rejected_before_selecting_latest(value):
+    native = Mock()
+    client = SimpleNamespace(namespace="tests", get_workflow_handle=native)
+    host = TemporalRunHost(TemporalHostConfig(namespace="tests"), client=client)
+    identity = TemporalRunIdentity(namespace="tests", workflow_id="workflow", run_id="first")
+    with pytest.raises(ValueError):
+        await host.get_pinned_handle(identity.model_copy(update={"run_id": value}))
+    native.assert_not_called()
+
+
+@pytest.mark.parametrize("parent_form", ["ordinary", "native", "other-generation"])
+async def test_pinned_parent_observes_only_children_of_its_actual_generation(parent_form):
+    identity = TemporalRunIdentity(namespace="tests", workflow_id="parent", run_id="first")
+    parent_id = (
+        "parent"
+        if parent_form == "ordinary"
+        else identity.model_copy(
+            update={"run_id": "other" if parent_form == "other-generation" else "first"}
+        ).encode()
+    )
+    request = RunRequest.create(coordination.echo, run_id="child", parent_run_id=parent_id)
+    payload = await DataConverter.default.encode_wrapper(
+        [RunParameters(request=request).model_dump(mode="json")]
+    )
+    native = AsyncMock()
+    native.describe.return_value = SimpleNamespace(
+        namespace="tests", id="parent", run_id="first", data_converter=DataConverter.default
+    )
+    native.fetch_history.return_value = SimpleNamespace(
+        events=[
+            HistoryEvent(
+                event_id=1,
+                event_type=EventType.EVENT_TYPE_START_CHILD_WORKFLOW_EXECUTION_INITIATED,
+                start_child_workflow_execution_initiated_event_attributes=(
+                    StartChildWorkflowExecutionInitiatedEventAttributes(
+                        workflow_id="child",
+                        workflow_type=WorkflowType(name=WORKFLOW_NAME),
+                        input=payload,
+                    )
+                ),
+            ),
+            HistoryEvent(
+                event_id=2,
+                event_type=EventType.EVENT_TYPE_CHILD_WORKFLOW_EXECUTION_STARTED,
+                child_workflow_execution_started_event_attributes=(
+                    ChildWorkflowExecutionStartedEventAttributes(initiated_event_id=1)
+                ),
+            ),
+        ]
+    )
+    handle = TemporalRunHandle(native, identity.encode())
+    if parent_form == "other-generation":
+        with pytest.raises(RunContractError):
+            await handle.children()
+    else:
+        assert await handle.children() == [request]
+
+
+@pytest.mark.parametrize("parent_form", ["ordinary", "native", "other-generation", "legacy"])
+async def test_child_status_retains_valid_recorded_parent_identity(parent_form):
+    identity = TemporalRunIdentity(namespace="tests", workflow_id="parent", run_id="first")
+    parent_id = {"ordinary": "parent", "legacy": ""}.get(parent_form)
+    if parent_id is None:
+        parent_id = identity.model_copy(
+            update={"run_id": "other" if parent_form == "other-generation" else "first"}
+        ).encode()
+    request = RunRequest.create(coordination.echo, run_id="child", parent_run_id=parent_id)
+    payload = await DataConverter.default.encode_wrapper(
+        [RunParameters(request=request).model_dump(mode="json")]
+    )
+    native = AsyncMock()
+    native.describe.return_value = SimpleNamespace(
+        status=WorkflowExecutionStatus.RUNNING,
+        namespace="tests",
+        id="child",
+        run_id="child-first",
+        parent_id="parent",
+        parent_run_id="first",
+        data_converter=DataConverter.default,
+    )
+
+    async def history(*, page_size):
+        assert page_size == 1
+        yield HistoryEvent(
+            event_id=1,
+            event_type=EventType.EVENT_TYPE_WORKFLOW_EXECUTION_STARTED,
+            workflow_execution_started_event_attributes=WorkflowExecutionStartedEventAttributes(
+                input=payload
+            ),
+        )
+        pytest.fail("Parent inspection should read only the start event")
+
+    native.fetch_history_events = history
+    handle = TemporalRunHandle(native, "child")
+    if parent_form == "other-generation":
+        with pytest.raises(RunContractError):
+            await handle.status()
+    else:
+        assert (await handle.status()).parent_run_id == (parent_id or "parent")
