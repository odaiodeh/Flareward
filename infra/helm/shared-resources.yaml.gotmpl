environments:
  default:
    values:
      - ./values/shared-resource-values.yaml
---

helmDefaults:
  createNamespace: false
  wait: false
  historyMax: 1

releases:

  - name: lumora-mongodb
    chart: ./shared-resources/mongodb
    wait: true
    timeout: 300
    values:
      - {{- toYaml .Values.mongodb | nindent 8 }}

  - name: lumora-redis-config
    chart: ./shared-resources/redis-config
    wait: true

  - name: lumora-redis
    chart: ./shared-resources/redis
    needs:
      - lumora-redis-config
    wait: true
    values:
      - {{- toYaml .Values.redis | nindent 8 }}
    hooks:
      - events: ["presync"]
        showlogs: true
        command: bash
        args:
        - "./scripts/redis-presync.sh"

  - name: lumora-redis-insight
    chart: ./shared-resources/redis-insight
    needs:
      - lumora-redis
    wait: true
    values:
     - {{- toYaml (index .Values "redis-insight") | nindent 8 }}

  - name: lumora-temporal
    chart: ./shared-resources/temporal
    wait: true
    values:
     - {{- toYaml .Values.temporal | nindent 8 }}

  - name: lumora-shared-config
    chart: ./shared-resources/shared-config
    wait: true
    needs:
      - lumora-mongodb
      - lumora-redis
      - lumora-redis-insight
      - lumora-temporal
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: bash
        args:
        - "./scripts/shared-resources-postsync.sh"

  - name: lumora-logging
    chart: ./shared-resources/logging
    # currently wait: true is commentd out as the logging pod isn't implemented yet, this comment will stay here as a placeholder so we won't forget it.
    values:
     - {{- toYaml .Values.logging | nindent 8 }}
