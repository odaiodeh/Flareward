{
  "version": 1,
  "filesystem_policy": {
    "include_workdir": true,
    "read_only": [
      "/usr",
      "/lib",
      "/proc",
      "/dev/urandom",
      "/app",
      "/etc",
      "/var/log",
      "/opt"
    ],
    "read_write": [
      "/sandbox",
      "/tmp",
      "/dev/null"
    ]
  },
  "landlock": {
    "compatibility": "best_effort"
  },
  "process": {
    "run_as_user": "sandbox",
    "run_as_group": "sandbox"
  },
  "network_policies": {
    "codex": {
      "endpoints": [
        {
          "host": "api.openai.com",
          "port": 443
        }
      ],
      "binaries": [
        {
          "path": "/usr/local/bin/codex"
        }
      ]
    }
  }
}
