ARG RECEIVER_BASE=python:3.14-slim
FROM ${RECEIVER_BASE}

USER root
WORKDIR /app

# Named build contexts copy only application/runtime source, never local credentials.
COPY --from=run_engine /pyproject.toml /opt/run-engine/pyproject.toml
COPY --from=run_engine /README.md /opt/run-engine/README.md
COPY --from=run_engine /src/ /opt/run-engine/src/
COPY --from=unifai /global_utils/pyproject.toml /opt/global-utils/pyproject.toml
COPY --from=unifai /global_utils/src/ /opt/global-utils/src/
COPY --from=unifai /multi-agent/pyproject.toml /opt/mas/pyproject.toml
COPY --from=unifai /multi-agent/lib/ /opt/mas/lib/
COPY --from=unifai /multi-agent/adapters/ /opt/mas/adapters/
COPY --from=unifai /multi-agent/bootstrap/ /opt/mas/bootstrap/
COPY --from=unifai /multi-agent/config/ /opt/mas/config/
COPY --from=unifai /multi-agent/plugins/ /opt/mas/plugins/
RUN pip install --no-cache-dir /opt/run-engine /opt/global-utils "/opt/mas[api,credentials,blueprints,telemetry]"

COPY --from=unifai /multi-agent/tests/support/ /opt/test-fixtures/support/
RUN python -c "from pathlib import Path; Path('/opt/unifai-e2e-receiver').write_text('unifai-platform-e2e-v1')"
ENV PYTHONPATH=/opt/test-fixtures

ARG RECEIVER_USER=1000:1000
RUN chown ${RECEIVER_USER} /app
USER ${RECEIVER_USER}
